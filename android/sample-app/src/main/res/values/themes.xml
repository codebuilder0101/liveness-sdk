<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SolistraSample" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/brand_cyan</item>
        <item name="colorOnPrimary">@color/text_on_brand</item>
        <item name="colorPrimaryContainer">@color/surface_card</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/brand_blue</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_highlight</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Status & Navigation bars -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
